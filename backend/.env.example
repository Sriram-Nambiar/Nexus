# NEXUS AI Backend Environment Configuration

# Server Network Configuration
# Set HOST to 127.0.0.1 for local development, or 0.0.0.0 for University LAN deployment
PORT=5000
HOST=127.0.0.1
ENABLE_LAN_ACCESS=false
BASE_URL=http://localhost:5000
NODE_ENV=development

# CORS Settings (comma-separated origins, or * for open campus LAN)
CORS_ORIGIN=*

# Storage and Database Paths (stored outside src directory)
DB_PATH=./data/nexus.sqlite
UPLOAD_DIR=./data/uploads

# Upload Restrictions
# 500 MB max file size (in bytes)
MAX_FILE_SIZE_BYTES=524288000

# AI Python Service Integration
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_API_KEY=
# Fallback mock mode when Python AI service is not running during local dev/testing
AI_MOCK_FALLBACK=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AI_RATE_LIMIT_MAX_REQUESTS=30

# Optional Administrative Secret Key
ADMIN_API_KEY=nexus-admin-secret-dev-key
