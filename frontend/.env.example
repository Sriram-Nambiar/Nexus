# NEXUS AI Frontend Environment Configuration

# Base URL for backend API requests (proxied to university server)
# In local development with backend running on port 8000: http://localhost:8000/api
# Default is /api (for local reverse proxy)
VITE_API_BASE_URL=/api

# Campus Node Identifier (optional display)
VITE_CAMPUS_NODE_ID=CAMPUS-LOCAL-NODE-01
